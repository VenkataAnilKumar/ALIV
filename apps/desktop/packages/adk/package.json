{
  "name": "@aliv/adk",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript client for the ALIV agent runtime: sessions, streamed turns, and host tools over `aliv cli agent rpc`",
  "keywords": [
    "aliv",
    "agent",
    "adk",
    "json-rpc"
  ],
  "homepage": "https://github.com/VenkataAnilKumar/ALIV",
  "license": "Apache-2.0",
  "author": "ALIV Contributors",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-types": "node scripts/generate.mjs --check && tsc -p tsconfig.json",
    "test": "node --test tests/adk.test.mjs tests/install.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2"
  }
}
