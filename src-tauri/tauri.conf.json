{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALIV",
  "version": "0.1.0",
  "identifier": "com.aliv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
